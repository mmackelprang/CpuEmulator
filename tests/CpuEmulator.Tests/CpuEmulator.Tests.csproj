<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seeded fixture for cross-source diff tests (test-only; not in the tools data/ directory). -->
    <Content Include="Importer\data\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Committed 680x0 TomHarte gzip fixture (M4.4b): always-on parse proof, no vector download. -->
    <None Include="TomHarte\fixtures\m68000-sample.json.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CpuEmulator.Core\CpuEmulator.Core.csproj" />
    <ProjectReference Include="..\..\src\CpuEmulator.Generators\CpuEmulator.Generators.csproj" />
    <ProjectReference Include="..\..\src\CpuEmulator.Cpus.Mos6502\CpuEmulator.Cpus.Mos6502.csproj" />
    <ProjectReference Include="..\..\src\CpuEmulator.Cpus.Z80\CpuEmulator.Cpus.Z80.csproj" />
    <ProjectReference Include="..\..\src\CpuEmulator.Cpus.M68000\CpuEmulator.Cpus.M68000.csproj" />
    <ProjectReference Include="..\..\tools\CpuEmulator.SpecImporter\CpuEmulator.SpecImporter.csproj" />
    <ProjectReference Include="..\..\src\CpuEmulator.Monitor\CpuEmulator.Monitor.csproj" />
    <ProjectReference Include="..\..\src\CpuEmulator.Peripherals\CpuEmulator.Peripherals.csproj" />
    <ProjectReference Include="..\..\src\CpuEmulator.Host\CpuEmulator.Host.csproj" />
    <ProjectReference Include="..\..\src\CpuEmulator.Jit\CpuEmulator.Jit.csproj" />
    <!-- The bench CORE library (Task 8 smoke test). NOT the runner — that owns BenchmarkDotNet, which
         is deliberately kept out of the test graph (wiring choice (b)). -->
    <ProjectReference Include="..\..\bench\CpuEmulator.Benchmarks\CpuEmulator.Benchmarks.csproj" />
  </ItemGroup>

</Project>
