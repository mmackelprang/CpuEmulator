<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- LangVersion/Nullable/ImplicitUsings come from Directory.Build.props.
         IsAotCompatible intentionally NOT set: tooling project, not a deployed binary. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The JSON data files the tool consumes are content-copied to output (and transitively to the
         test project). The generator scripts (*.py) + the review report (*.md) are provenance
         artifacts, not runtime inputs — excluded from the copy. -->
    <Content Include="data\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
