{
  "architecture": "mos6502",
  "namespace": "CpuEmulator.Cpus.Mos6502",
  "specClassName": "Mos6502Spec",
  "registers": [
    { "name": "A",  "bits": 8  },
    { "name": "X",  "bits": 8  },
    { "name": "Y",  "bits": 8  },
    { "name": "S",  "bits": 8,  "role": "StackPointer"   },
    { "name": "P",  "bits": 8,  "role": "Status"         },
    { "name": "PC", "bits": 16, "role": "ProgramCounter" }
  ],
  "mnemonics": {
    "LDA": "[Load(\"A\"), SetNZ(\"A\")]",
    "LDX": "[Load(\"X\"), SetNZ(\"X\")]",
    "LDY": "[Load(\"Y\"), SetNZ(\"Y\")]",
    "STA": "[Store(\"A\")]",
    "STX": "[Store(\"X\")]",
    "STY": "[Store(\"Y\")]",
    "TAX": "[Transfer(\"A\", \"X\"), SetNZ(\"X\")]",
    "TXA": "[Transfer(\"X\", \"A\"), SetNZ(\"A\")]",
    "TAY": "[Transfer(\"A\", \"Y\"), SetNZ(\"Y\")]",
    "TYA": "[Transfer(\"Y\", \"A\"), SetNZ(\"A\")]",
    "TSX": "[Transfer(\"S\", \"X\"), SetNZ(\"X\")]",
    "TXS": "[Transfer(\"X\", \"S\")]",
    "INX": "[Increment(\"X\"), SetNZ(\"X\")]",
    "INY": "[Increment(\"Y\"), SetNZ(\"Y\")]",
    "JMP": "[Jump()]",
    "NOP": "[]",
    "BNE": "[BranchIf(Flag.Z, false)]",
    "BEQ": "[BranchIf(Flag.Z, true)]",
    "BCC": "[BranchIf(Flag.C, false)]",
    "BCS": "[BranchIf(Flag.C, true)]",
    "BPL": "[BranchIf(Flag.N, false)]",
    "BMI": "[BranchIf(Flag.N, true)]",
    "BVC": "[BranchIf(Flag.V, false)]",
    "BVS": "[BranchIf(Flag.V, true)]",
    "ADC": "[Adc()]",
    "SBC": "[Sbc()]",
    "AND": "[And()]",
    "ORA": "[Ora()]",
    "EOR": "[Eor()]",
    "BIT": "[Bit()]",
    "CMP": "[Compare(\"A\")]",
    "CPX": "[Compare(\"X\")]",
    "CPY": "[Compare(\"Y\")]",
    "ASL": "[ShiftLeft()]",
    "LSR": "[ShiftRight()]",
    "ROL": "[RotateLeft()]",
    "ROR": "[RotateRight()]",
    "INC": "[IncrementMem()]",
    "DEC": "[DecrementMem()]",
    "DEX": "[Decrement(\"X\"), SetNZ(\"X\")]",
    "DEY": "[Decrement(\"Y\"), SetNZ(\"Y\")]",
    "PHA": "[Push(\"A\")]",
    "PLA": "[Pull(\"A\")]",
    "PHP": "[PushP()]",
    "PLP": "[PullP()]",
    "CLC": "[SetFlag(Flag.C, false)]",
    "SEC": "[SetFlag(Flag.C, true)]",
    "CLI": "[SetFlag(Flag.I, false)]",
    "SEI": "[SetFlag(Flag.I, true)]",
    "CLV": "[SetFlag(Flag.V, false)]",
    "CLD": "[SetFlag(Flag.D, false)]",
    "SED": "[SetFlag(Flag.D, true)]",
    "JSR": "[Jsr()]",
    "RTS": "[Rts()]",
    "BRK": "[Brk()]",
    "RTI": "[Rti()]"
  }
}
