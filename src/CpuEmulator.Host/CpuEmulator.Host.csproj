<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOT NativeAOT-publishable (changed in "CPUs → computers" piece #3).
    The Host now boots any board through CpuEmulator.Machines / BoardMachineFactory and
    supports the JIT execution tier (there is a Z80-on-JIT host smoke). CpuEmulator.Machines
    transitively references CpuEmulator.Jit, which uses System.Reflection.Emit.DynamicMethod
    (RequiresDynamicCode) — so `dotnet publish -r <rid>` with PublishAot fails IL3050. The
    prior AOT-publish invariant (when the Host hand-wired only the AOT-clean Mos6502 core)
    retired with piece #3; PublishAot is intentionally NOT set here anymore. If a NativeAOT
    Host is wanted in future it needs a slim, Jit-free board-build seam (a roadmap follow-on).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CpuEmulator.Core\CpuEmulator.Core.csproj" />
    <ProjectReference Include="..\CpuEmulator.Cpus.Mos6502\CpuEmulator.Cpus.Mos6502.csproj" />
    <ProjectReference Include="..\CpuEmulator.Peripherals\CpuEmulator.Peripherals.csproj" />
    <ProjectReference Include="..\CpuEmulator.Monitor\CpuEmulator.Monitor.csproj" />
    <ProjectReference Include="..\CpuEmulator.Machines\CpuEmulator.Machines.csproj" />
  </ItemGroup>

</Project>
