<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The JIT tier. This is the ONLY assembly that uses System.Reflection.Emit, so it is the
    ONLY non-AOT member of the graph (spec section 3 "load-bearing packaging rule"). Deliberately
    NOT IsAotCompatible: Reflection.Emit / DynamicMethod require a runtime JIT and are
    unsupported under NativeAOT (research section 4). NativeAOT consumers never reference this.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!--
      J1 (M3.5-3a): the JIT assembly is now GENERIC over the CPU type (BlockCompiler<TCpu> +
      JittedCpu<TCpu> + the IJitTarget per-CPU seam), so it no longer references any CONCRETE CPU
      assembly — a structural genericity proof. The Mos6502 ProjectReference is removed; the JIT
      resolves all CPU-specific reflection + decode through Mos6502Cpu.JitTarget / Z80Cpu.JitTarget,
      injected by the caller. Core carries the IJitTarget contract.
    -->
    <ProjectReference Include="..\CpuEmulator.Core\CpuEmulator.Core.csproj" />
  </ItemGroup>
</Project>
